# ---- LLM keys ---------------------------------------------------------
# Needed for manager and worker models (defaults use Groq).
GROQ_API_KEY=your-groq-api-key
# Only needed if you set MANAGER_LLM / WORKER_LLM to an "anthropic/..." model.
# ANTHROPIC_API_KEY=your-anthropic-key

# ---- Search keys (set at least ONE; Tavily is used first if both exist) ---
TAVILY_API_KEY=tvly-your-tavily-key
SERPER_API_KEY=your-serper-dev-key

# ---- Optional overrides -------------------------------------------------
# Recommended Groq models: a capable manager and a tool-calling research worker.
# MANAGER_LLM=groq/openai/gpt-oss-120b
# WORKER_LLM=groq/qwen/qwen3.8-27b
# OPENAI_API_KEY=your-openai-key # only needed for OpenAI models
# REPORT_OUTPUT_DIR=output
